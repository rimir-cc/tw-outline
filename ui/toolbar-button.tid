title: $:/plugins/rimir/outline/ui/toolbar-button
tags: $:/tags/ViewToolbar
caption: {{$:/plugins/rimir/outline/ui/toolbar-icon}} outline
description: Toggle outline mode: select, edit, move and indent the blocks of this tiddler in place

\whitespace trim
<!-- Only for wikitext tiddlers that are not drafts. State: $:/state/rimir/outline/on/<title> = yes/no -->
<%if [<currentTiddler>!has[draft.of]] :filter[get[type]else[text/vnd.tiddlywiki]match[text/vnd.tiddlywiki]] %>
<$let state={{{ [<currentTiddler>addprefix[$:/state/rimir/outline/on/]] }}}
	on={{{ [<state>get[text]match[yes]] }}}
	tooltip={{$:/plugins/rimir/outline/ui/toolbar-button!!description}}>
<$button tooltip=<<tooltip>> aria-label="outline"
	class={{{ [<tv-config-toolbar-class>] [<on>match[yes]then[tc-selected]] +[join[ ]] }}}>
<$action-setfield $tiddler=<<state>> text={{{ [<on>match[yes]then[no]else[yes]] }}}/>
<%if [<tv-config-toolbar-icons>match[yes]] %>
{{$:/plugins/rimir/outline/ui/toolbar-icon}}
<%endif%>
<%if [<tv-config-toolbar-text>match[yes]] %>
<span class="tc-btn-text">outline</span>
<%endif%>
</$button>
</$let>
<%endif%>
