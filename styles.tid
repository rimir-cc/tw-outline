title: $:/plugins/rimir/outline/styles
tags: $:/tags/Stylesheet

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

.rr-ol {
	position: relative;
	outline: none;
}

.rr-ol-selected,
.rr-ol-selbox {
	outline: 1px solid <<colour primary>>;
	outline-offset: 2px;
}

/* A selected list item with sub-items: the frame is drawn by .rr-ol-selbox around the item's own lines only */
.rr-ol-selected.rr-ol-selected-own {
	outline: none;
}

.rr-ol-selbox {
	position: absolute;
	pointer-events: none;
}

/* An open editor marks the place itself */
.rr-ol-is-editing .rr-ol-selected,
.rr-ol-is-editing .rr-ol-selbox {
	outline: none;
}

/* Another view of the same tiddler shows the selection without keyboard focus */
.rr-ol:not(:focus-within) .rr-ol-selected,
.rr-ol:not(:focus-within) .rr-ol-selbox {
	outline-color: <<colour muted-foreground>>;
}

.rr-ol-editing {
	display: none;
}

/* Edited list item: the editor host is its first child. The item's own content (and its marker) takes no
   space: its elements are not displayed, its bare text has zero size. The editor and the nested sub-items get
   the item's font size and line height back (set by the editor as custom properties). */
.rr-ol-editing-own {
	visibility: hidden;
	font-size: 0;
	line-height: 0;
}

.rr-ol-editing-own > :not(.rr-ol-editor-host):not(ul):not(ol):not(dl):not(blockquote) {
	display: none;
}

.rr-ol-editing-own > .rr-ol-editor-host,
.rr-ol-editing-own > ul,
.rr-ol-editing-own > ol,
.rr-ol-editing-own > dl,
.rr-ol-editing-own > blockquote {
	visibility: visible;
	font-size: var(--rr-ol-font-size);
	line-height: var(--rr-ol-line-height);
}

.rr-ol-tmark {
	display: inline-block;
	margin-left: 0.4em;
	vertical-align: middle;
	line-height: 1;
	cursor: pointer;
	opacity: 0.6;
	transition: opacity 0.15s ease-in-out;
}

.rr-ol-tmark svg {
	width: 0.95em;
	height: 0.95em;
	fill: <<colour muted-foreground>>;
}

.rr-ol-tmark:hover {
	opacity: 1;
}

.rr-ol-tmark:hover svg {
	fill: <<colour primary>>;
}

/* In-place editor: sits where the edited unit was (or after the anchor of a new unit) */
.rr-ol-editor-host {
	margin: 0.2em 0;
}

/* Compact editor: one line that grows with its content, looks like an input field */
.rr-ol-editor-compact {
	display: block;
	box-sizing: border-box;
	width: 100%;
	margin: 0;
	padding: 1px 4px;
	font: inherit;
	line-height: inherit;
	color: <<colour foreground>>;
	background: <<colour background>>;
	border: 1px solid <<colour primary>>;
	border-radius: 3px;
	resize: none;
	overflow: hidden;
}

/* A new list item outside a list (block menu after a paragraph, heading, ...) shows its marker like one in a list.
   Its marker type, and that of a new item whose level (Tab / Shift-Tab while empty) has another type than its list */
div.rr-ol-editor-host[data-ol-type="bullet"],
div.rr-ol-editor-host[data-ol-type="numbered"] {
	display: list-item;
	margin-left: 40px;
}

div.rr-ol-editor-host[data-ol-type="bullet"],
ol > li.rr-ol-editor-host[data-ol-type="bullet"] {
	list-style-type: disc;
}

div.rr-ol-editor-host[data-ol-type="numbered"],
ul > li.rr-ol-editor-host[data-ol-type="numbered"] {
	list-style-type: decimal;
}

.rr-ol-editor-host .tc-editor-toolbar {
	margin-bottom: 0.2em;
}

/* Copy feedback: a short highlight of the copied unit, also on everything inside it, so that no element with its own
   background covers it (a code block's pre, highlighted code, a plugin's wrapper around code blocks, table cells) */
.rr-ol-copied,
.rr-ol-copied * {
	animation: rr-ol-copied 0.6s ease-out;
}

@keyframes rr-ol-copied {
	from {
		background-color: <<colour primary>>;
	}
}

/* Hint in a tiddler without units (Enter / Shift-Enter start the first block) */
.rr-ol-empty {
	padding: 0.4em 0;
	color: <<colour muted-foreground>>;
	font-style: italic;
	cursor: text;
}

.rr-ol-is-editing .rr-ol-empty {
	display: none;
}

/* Block menu (Shift-Enter) */
.rr-ol-menu {
	position: absolute;
	z-index: 1000;
	min-width: 12em;
	max-height: 22em;
	overflow-y: auto;
	padding: 0.25em 0;
	background: <<colour dropdown-background>>;
	border: 1px solid <<colour dropdown-border>>;
	border-radius: 4px;
	box-shadow: 1px 1px 5px rgba(0, 0, 0, 0.15);
	font-size: 0.9em;
	line-height: 1.5;
}

.rr-ol-menu-group {
	padding: 0.2em 0.8em 0.1em;
	font-size: 0.8em;
	color: <<colour muted-foreground>>;
	text-transform: uppercase;
}

.rr-ol-menu-item {
	padding: 0.1em 0.8em 0.1em 1.2em;
	cursor: pointer;
	white-space: nowrap;
}

.rr-ol-menu-item.rr-ol-menu-active,
.rr-ol-menu-item:hover {
	background: <<colour dropdown-tab-background-selected>>;
	color: <<colour foreground>>;
}

.rr-ol-menu-item.rr-ol-menu-active {
	background: <<colour primary>>;
	color: <<colour background>>;
}

.rr-ol-notice {
	margin-bottom: 0.3em;
	padding: 0.3em 0.6em;
	border-left: 3px solid <<colour alert-highlight>>;
	background: <<colour alert-background>>;
	color: <<colour alert-foreground>>;
}

/* Key overview: a small ? at the top right of the outline, the overview floats below it */
.rr-ol-frame {
	position: relative;
}

.rr-ol-help-bar {
	position: absolute;
	top: 0;
	right: 0;
	z-index: 900;
	height: 0;
}

.rr-ol-help-button.tc-btn-invisible {
	position: absolute;
	top: -1.6em;
	right: 0;
	width: 1.4em;
	height: 1.4em;
	line-height: 1.3em;
	padding: 0;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: 50%;
	font-size: 0.8em;
	font-weight: bold;
	color: <<colour muted-foreground>>;
	opacity: 0.6;
}

.rr-ol-help-button.tc-btn-invisible:hover {
	opacity: 1;
	color: <<colour primary>>;
	border-color: <<colour primary>>;
}

.rr-ol-help {
	position: absolute;
	top: 0.2em;
	right: 0;
	width: 26em;
	max-width: calc(100vw - 2em);
	max-height: 70vh;
	overflow-y: auto;
	padding: 0.5em 0.8em;
	background: <<colour dropdown-background>>;
	border: 1px solid <<colour dropdown-border>>;
	border-radius: 4px;
	box-shadow: 1px 1px 5px rgba(0,0,0,0.15);
	font-size: 0.9em;
}

.rr-ol-help-close.tc-btn-invisible {
	float: right;
	padding: 0;
}

.rr-ol-help-close svg {
	width: 0.9em;
	height: 0.9em;
	fill: <<colour muted-foreground>>;
}

.rr-ol-keys-group {
	margin-bottom: 0.7em;
}

.rr-ol-keys-caption {
	font-weight: bold;
	margin-bottom: 0.2em;
}

table.rr-ol-keys-table {
	width: 100%;
	margin: 0;
	border: none;
}

table.rr-ol-keys-table td {
	padding: 0.1em 0.4em 0.1em 0;
	border: none;
	vertical-align: top;
}

td.rr-ol-keys-key {
	width: 7.5em;
	white-space: nowrap;
}

.rr-ol-keys-hint {
	font-size: 0.85em;
	color: <<colour muted-foreground>>;
}

/* Type badges ($:/config/rimir/outline/badges: all, headings, off). The text is the unit's data-ol-type (set by
   the widget; the editor field carries the type of what it edits). Absolutely positioned, so no unit and no editor
   field moves or grows: they sit in a column reserved on the right of the outline (padding), each at the top of its
   unit; a whole list or container a line above it (its first item has the badge beside it); code blocks inside
   their top right corner (they clip overflow). */
.rr-ol-badges-all .rr-ol {
	padding-right: 6.5em;
}

.rr-ol-badges-headings .rr-ol {
	padding-right: 2.5em;
}

.rr-ol-badges-all [data-ol-type],
.rr-ol-badges-headings [data-ol-kind="heading"],
.rr-ol-badges-headings .rr-ol-editor-host[data-ol-type^="h"] {
	position: relative;
}

.rr-ol-badges-all [data-ol-type]::after,
.rr-ol-badges-headings [data-ol-kind="heading"]::after,
.rr-ol-badges-headings .rr-ol-editor-host[data-ol-type^="h"]::after {
	content: attr(data-ol-type);
	/* Not read out by screen readers (browsers without alt text keep the line above) */
	content: attr(data-ol-type) / "";
	position: absolute;
	top: 0;
	left: 100%;
	margin-left: 8px;
	padding: 0 4px;
	border: 1px solid <<colour tiddler-border>>;
	border-radius: 3px;
	font-family: sans-serif;
	font-size: 9px;
	font-weight: normal;
	font-style: normal;
	line-height: 13px;
	letter-spacing: 0;
	text-transform: none;
	text-indent: 0;
	white-space: nowrap;
	color: <<colour muted-foreground>>;
	background: <<colour tiddler-background>>;
	opacity: 0.7;
	pointer-events: none;
	/* Stays visible in an edited list item (its own content is hidden) */
	visibility: visible;
}

.rr-ol-badges-all [data-ol-kind="list"]::after,
.rr-ol-badges-all [data-ol-kind="container"]::after {
	top: -15px;
}

/* A quote's lines carry the badge, the quote as a whole does not repeat it */
.rr-ol-badges-all [data-ol-kind="list"][data-ol-type="quote"]::after {
	content: none;
}

.rr-ol-badges-all pre[data-ol-type]::after,
.rr-ol-badges-all .rr-ol-editor-host[data-ol-type="code-block"]::after {
	left: auto;
	right: 3px;
	top: 3px;
	margin-left: 0;
}
