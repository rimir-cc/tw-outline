title: $:/config/shortcuts/

outline-up: Up
outline-down: Down
outline-up-deep: ctrl-Up
outline-down-deep: ctrl-Down
outline-parent: Left
outline-child: Right
outline-move-up: alt-Up
outline-move-down: alt-Down
outline-indent: Tab
outline-promote: shift-Tab
outline-edit: Enter
outline-menu: shift-Enter
outline-open: Enter
outline-clear: Escape
outline-save: ctrl-Enter
outline-continue: Enter
outline-newline: shift-Enter
outline-cancel: Escape
outline-edit-up: ctrl-Up
outline-edit-down: ctrl-Down
outline-help: shift-slash
outline-delete: Delete
outline-merge: Backspace
outline-undo: ctrl-Z
outline-redo: ctrl-Y ctrl-shift-Z
